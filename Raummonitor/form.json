{
    "elements": [
        {
            "type": "Label",
            "caption": "Raummonitor – beliebige Symcon-Variablen, keine KNX-Herstellerbindung. Nur der Raumname ist Pflicht; alle Messwerte und die Detailseite sind optional."
        },
        {
            "type": "List",
            "name": "Rooms",
            "caption": "Räume und Messwerte (Details per Hinzufügen/Bearbeiten)",
            "rowCount": 10,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {"name": "Group", "caption": "Gruppe / Etage", "width": "150px", "add": "", "edit": {"type": "ValidationTextBox"}},
                {"name": "Room", "caption": "Raumname *", "width": "auto", "add": "", "edit": {"type": "ValidationTextBox"}},
                {"name": "ActualTempID", "visible": false, "add": 0, "edit": {"type": "SelectVariable"}},
                {"name": "DetailCategoryID", "visible": false, "add": 1, "edit": {"type": "SelectCategory"}},
                {"name": "SetpointTempID", "visible": false, "add": 0, "edit": {"type": "SelectVariable"}},
                {"name": "OperationModeID", "visible": false, "add": 0, "edit": {"type": "SelectVariable"}},
                {"name": "WindowID", "visible": false, "add": 0, "edit": {"type": "SelectVariable"}},
                {"name": "WindowInverted", "visible": false, "add": false, "edit": {"type": "CheckBox"}},
                {"name": "PresenceID", "visible": false, "add": 0, "edit": {"type": "SelectVariable"}},
                {"name": "PresenceInverted", "visible": false, "add": false, "edit": {"type": "CheckBox"}},
                {"name": "ValveID", "visible": false, "add": 0, "edit": {"type": "SelectVariable"}},
                {"name": "ValveMax", "visible": false, "add": 100, "edit": {"type": "NumberSpinner", "minimum": 1, "maximum": 65535}},
                {"name": "LightCountID", "visible": false, "add": 0, "edit": {"type": "SelectVariable"}},
                {"name": "HumidityID", "visible": false, "add": 0, "edit": {"type": "SelectVariable"}},
                {"name": "CO2ID", "visible": false, "add": 0, "edit": {"type": "SelectVariable"}},
                {"name": "DewPointID", "visible": false, "add": 0, "edit": {"type": "SelectVariable"}},
                {"name": "HeatingCoolingID", "visible": false, "add": 0, "edit": {"type": "SelectVariable"}}
            ],
            "form": [
                {"type": "Label", "caption": "Raumname (Pflicht); Etage und sämtliche Messwerte sind optional"},
                {"type": "ValidationTextBox", "name": "Group", "caption": "Gruppe / Etage (optional)"},
                {"type": "ValidationTextBox", "name": "Room", "caption": "Raumname *"},
                {
                    "type": "ExpansionPanel",
                    "caption": "Navigation zur Detailseite (optional)",
                    "expanded": false,
                    "items": [
                        {"type": "SelectCategory", "name": "DetailCategoryID", "caption": "Detailseite", "value": 1},
                        {"type": "Label", "caption": "Kein(e) = keine Detailseite (Standard). Der Raumname bleibt dann normaler Text. Wähle eine vorhandene Raumkategorie, um den Seitenwechsel zu aktivieren. Bereits gespeicherte Zielkategorien bleiben erhalten. Hinweis: IP Symcon bezeichnet das Wurzelobjekt und ist keine Raum-Detailseite."}
                    ]
                },
                {
                    "type": "ExpansionPanel",
                    "caption": "Heizung, Fenster, Licht und Präsenz (optional)",
                    "expanded": false,
                    "items": [
                        {"type": "SelectVariable", "name": "ActualTempID", "caption": "Isttemperatur"},
                        {"type": "SelectVariable", "name": "SetpointTempID", "caption": "Solltemperatur"},
                        {"type": "SelectVariable", "name": "OperationModeID", "caption": "Betriebsart"},
                        {"type": "SelectVariable", "name": "WindowID", "caption": "Fensterkontakt"},
                        {"type": "Label", "caption": "Optional: Weitere Fensterkontakte können unten in der separaten Fensterliste ergänzt werden."},
                        {"type": "CheckBox", "name": "WindowInverted", "caption": "Fenster invertieren (true = geschlossen)"},
                        {"type": "SelectVariable", "name": "PresenceID", "caption": "Präsenzmelder"},
                        {"type": "Label", "caption": "Optional: Weitere Präsenzmelder können unten in der separaten Präsenzliste ergänzt werden."},
                        {"type": "CheckBox", "name": "PresenceInverted", "caption": "Präsenz invertieren (true = keine Präsenz)"},
                        {"type": "SelectVariable", "name": "ValveID", "caption": "Ventilstellung"},
                        {"type": "NumberSpinner", "name": "ValveMax", "caption": "Ventil-Rohwert für 100 %", "minimum": 1, "maximum": 65535},
                        {"type": "SelectVariable", "name": "LightCountID", "caption": "Fertige Lichtanzahl (alternativ zur Lichtliste)"}
                    ]
                },
                {
                    "type": "ExpansionPanel",
                    "caption": "Weitere Klimawerte (optional)",
                    "expanded": false,
                    "items": [
                        {"type": "SelectVariable", "name": "HumidityID", "caption": "Luftfeuchtigkeit"},
                        {"type": "SelectVariable", "name": "CO2ID", "caption": "CO₂-Wert"},
                        {"type": "SelectVariable", "name": "DewPointID", "caption": "Taupunkt"},
                        {"type": "SelectVariable", "name": "HeatingCoolingID", "caption": "Heizen / Kühlen"}
                    ]
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Auch reine Licht-, Fenster-, Präsenz- oder Navigationsräume sind möglich. Ein Raum ohne Variablen und ohne Detailseite wird nur mit Namen angezeigt. Lichter: Pro Leuchte eine Zeile in der zweiten Liste eintragen; Gruppe und Raum müssen exakt einer Zeile oben entsprechen. Eine vorhandene Lichtanzahl-Variable im Raum hat Vorrang."
        },
        {
            "type": "List",
            "name": "Lights",
            "caption": "Lichtvariablen je Raum (optional)",
            "rowCount": 8,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {"name": "Group", "caption": "Gruppe / Etage", "width": "140px", "add": "", "edit": {"type": "ValidationTextBox"}},
                {"name": "Room", "caption": "Raumname", "width": "180px", "add": "", "edit": {"type": "ValidationTextBox"}},
                {"name": "VariableID", "caption": "Schaltstatus", "width": "240px", "add": 0, "edit": {"type": "SelectVariable"}},
                {"name": "Invert", "caption": "Invertieren", "width": "110px", "add": false, "edit": {"type": "CheckBox"}}
            ]
        },
        {
            "type": "Label",
            "caption": "Mehrere Fenster: Pro Fensterkontakt eine Zeile anlegen. Gruppe und Raum müssen exakt einer Raumzeile oben entsprechen. Ein bestehender Einzelkontakt bleibt zusätzlich gültig; doppelte Variablen-IDs werden pro Raum nur einmal gezählt."
        },
        {
            "type": "List",
            "name": "Windows",
            "caption": "Fensterkontakte je Raum (optional)",
            "rowCount": 6,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {"name": "Group", "caption": "Gruppe / Etage", "width": "150px", "add": "", "edit": {"type": "ValidationTextBox"}},
                {"name": "Room", "caption": "Raumname", "width": "auto", "add": "", "edit": {"type": "ValidationTextBox"}},
                {"name": "Name", "caption": "Fenster", "width": "180px", "add": "", "edit": {"type": "ValidationTextBox"}},
                {"name": "VariableID", "visible": false, "add": 0, "edit": {"type": "SelectVariable"}},
                {"name": "Invert", "visible": false, "add": false, "edit": {"type": "CheckBox"}}
            ],
            "form": [
                {"type": "ValidationTextBox", "name": "Group", "caption": "Gruppe / Etage (wie in der Raumliste)"},
                {"type": "ValidationTextBox", "name": "Room", "caption": "Raumname (wie in der Raumliste)"},
                {"type": "ValidationTextBox", "name": "Name", "caption": "Fensterbezeichnung (optional)"},
                {"type": "SelectVariable", "name": "VariableID", "caption": "Fensterkontaktvariable"},
                {"type": "CheckBox", "name": "Invert", "caption": "Kontakt invertieren (true = geschlossen)"}
            ]
        },
        {
            "type": "Label",
            "caption": "Mehrere Präsenzmelder: Pro Melder eine Zeile anlegen. Gruppe und Raum müssen zur Raumliste passen. Der Melder im Raumdialog gilt zusätzlich; gleiche Variablen-IDs werden pro Raum nur einmal ausgewertet. Präsenz bedeutet einen gemeldeten Sensorzustand, nicht eine sichere Raumbelegung."
        },
        {
            "type": "List",
            "name": "Presences",
            "caption": "Präsenzmelder je Raum (optional)",
            "rowCount": 6,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {"name": "Group", "caption": "Gruppe / Etage", "width": "150px", "add": "", "edit": {"type": "ValidationTextBox"}},
                {"name": "Room", "caption": "Raumname", "width": "auto", "add": "", "edit": {"type": "ValidationTextBox"}},
                {"name": "Name", "caption": "Melder", "width": "180px", "add": "", "edit": {"type": "ValidationTextBox"}},
                {"name": "VariableID", "visible": false, "add": 0, "edit": {"type": "SelectVariable"}},
                {"name": "Invert", "visible": false, "add": false, "edit": {"type": "CheckBox"}}
            ],
            "form": [
                {"type": "ValidationTextBox", "name": "Group", "caption": "Gruppe / Etage (wie in der Raumliste)"},
                {"type": "ValidationTextBox", "name": "Room", "caption": "Raumname (wie in der Raumliste)"},
                {"type": "ValidationTextBox", "name": "Name", "caption": "Melderbezeichnung (optional)"},
                {"type": "SelectVariable", "name": "VariableID", "caption": "Präsenzvariable"},
                {"type": "CheckBox", "name": "Invert", "caption": "Präsenz invertieren (true = keine Präsenz)"}
            ]
        },
        {"type": "Label", "caption": "KNX DPT 20.102 (HVAC-Modus): 0=Automatik, 1=Komfort, 2=Standby, 3=Nacht/Economy, 4=Frost-/Hitzeschutz. 0=Automatik wird automatisch erkannt; eine individuelle Zuordnung des Werts 0 zu einem der vier Modi hat Vorrang."},
        {
            "type": "RowLayout",
            "items": [
                {"type": "NumberSpinner", "name": "ComfortValue", "caption": "Komfort", "minimum": -32768, "maximum": 32767},
                {"type": "NumberSpinner", "name": "StandbyValue", "caption": "Standby", "minimum": -32768, "maximum": 32767},
                {"type": "NumberSpinner", "name": "NightValue", "caption": "Nacht", "minimum": -32768, "maximum": 32767},
                {"type": "NumberSpinner", "name": "FrostValue", "caption": "Frostschutz", "minimum": -32768, "maximum": 32767}
            ]
        },
        {"type": "CheckBox", "name": "CoolingWhenTrue", "caption": "Heizen/Kühlen: true bzw. 1 bedeutet Kühlen"},
        {"type": "CheckBox", "name": "GroupRooms", "caption": "Räume nach Gruppe / Etage zusammenfassen"},
        {"type": "CheckBox", "name": "AutoColumns", "caption": "Tabellenspalten automatisch nach verwendeten Variablen anzeigen (Standard)"},
        {"type": "CheckBox", "name": "ShowExtraColumns", "caption": "Optionale Klima-Spalten (Feuchte, CO₂, Taupunkt, Heizen/Kühlen) anzeigen"},
        {
            "type": "ExpansionPanel",
            "caption": "Plausibilitätsprüfung für Raumtemperaturen",
            "expanded": false,
            "items": [
                {"type": "CheckBox", "name": "ValidateTemperatures", "caption": "Ist- und Solltemperaturen auf plausiblen Bereich prüfen"},
                {
                    "type": "RowLayout",
                    "items": [
                        {"type": "NumberSpinner", "name": "MinimumTemperature", "caption": "Untergrenze", "digits": 1, "suffix": "°C", "minimum": -273, "maximum": 200, "width": "160px"},
                        {"type": "NumberSpinner", "name": "MaximumTemperature", "caption": "Obergrenze", "digits": 1, "suffix": "°C", "minimum": -273, "maximum": 200, "width": "160px"}
                    ]
                },
                {"type": "Label", "caption": "Standard: −20 bis +60 °C. Bei Über- oder Unterschreitung zeigt die Kachel – und die Instanz meldet Status 202. Die Originalvariablen werden nicht verändert. Die Untergrenze muss kleiner als die Obergrenze sein."}
            ]
        },
        {"type": "NumberSpinner", "name": "RefreshSeconds", "caption": "Zyklische Aktualisierung (s)", "minimum": 0, "maximum": 3600},
        {"type": "Label", "caption": "0 = nur bei Variablenänderungen aktualisieren (Standard). Ein Wert ab 1 aktiviert die zusätzliche zyklische Prüfung im eingestellten Sekundenabstand."}
    ],
    "actions": [
        {"type": "Button", "caption": "Jetzt aktualisieren", "onClick": "RMON_Update($id);"},
        {"type": "Label", "caption": "Fehlende und ungültige Variablen werden als – angezeigt und führen zu einer Statusmeldung der Instanz. Das Modul schaltet selbst keine Geräte."}
    ],
    "status": [
        {"code": 102, "icon": "active", "caption": "Raummonitor aktiv"},
        {"code": 104, "icon": "inactive", "caption": "Keine Räume konfiguriert"},
        {"code": 201, "icon": "error", "caption": "Konfiguration enthält Fehler"},
        {"code": 202, "icon": "error", "caption": "Mindestens ein Messwert ist nicht verfügbar"}
    ]
}
